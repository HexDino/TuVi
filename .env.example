# ===========================================================================
# LLM — bắt buộc. Mọi provider OpenAI-compatible đều chạy được.
# ===========================================================================

# --- Anthropic Claude (đã kiểm chứng với claude-sonnet-5-5) ---
LLM_API_KEY=sk-ant-...
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-sonnet-5-5
LLM_MODEL_FALLBACKS=claude-sonnet-4-5-20250929,claude-haiku-5-5
# Claude 5.x: thinking ăn vào max_tokens → tắt để JSON không bị cắt giữa chừng
LLM_EXTRA_BODY={"reasoning_effort":"none"}

# --- Google Gemini (đã kiểm chứng) ---
# LLM_API_KEY=AQ...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash
# LLM_MODEL_FALLBACKS=gemini-3.1-flash-lite
# Gemini 3.x cũng cần hạ mức thinking
# LLM_REASONING_EFFORT=low

# --- OpenAI ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- DeepSeek — rẻ nhất trong các lựa chọn chất lượng ổn ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_MODEL_FALLBACKS=deepseek-reasoner

# --- xAI Grok — API chính thức (trả tiền như mọi API khác) ---
# Lưu ý: đây là API, KHÔNG phải "mượn" gói chat của X Premium. CHƯA KIỂM CHỨNG
# trên repo này (không có key để thử) — tự xác nhận trước khi dùng production.
# LLM_API_KEY=xai-...
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4-fast

# --- Gemini free tier (AI Studio) — 0 đồng, nhưng quota thấp ---
# Mỗi model được ~20 request/ngày. Một báo cáo = 4 request → ~5 báo cáo/ngày/model.
# Dùng để phát triển, không dùng cho production.
# Khai nhiều model vào FALLBACKS để có thêm quota:
# LLM_API_KEY=AQ...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash
# LLM_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.8-flash
# LLM_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# TIẾT KIỆM CHI PHÍ — đọc mục "Chi phí vận hành" trong README trước khi đổi
# ---------------------------------------------------------------------------

# Cache báo cáo trên đĩa. Cùng một lá số + cùng prompt + cùng model → lần thứ
# hai trả ngay, KHÔNG gọi model, 0 token. Đây là khoản tiết kiệm lớn nhất.
#   true  (mặc định): dùng lại bản đã viết
#   false           : luôn gọi model (chỉ dùng khi debug prompt)
REPORT_CACHE=true

# Chế độ sinh. 'chunked' = 4 lần gọi (Tổng quan + 3 nhóm cung).
# 'full' = 1 lần gọi, input rẻ hơn ~37% NHƯNG ĐÃ THỬ VÀ HỎNG với Claude compat:
#   - để nguyên response_format → "compiled grammar is too large"
#   - bỏ response_format        → "could not parse the response" (JSON 12 cung
#     không có schema ép thì model trả về không parse được)
# Chỉ dùng 'full' nếu bạn tự kiểm chứng được với provider đang dùng.
LLM_CHUNK_MODE=chunked

# ---------------------------------------------------------------------------
# Tinh chỉnh (mặc định đã đúng cho phần lớn trường hợp)
# ---------------------------------------------------------------------------
# Trần token mỗi lần gọi. Báo cáo chia 4 lần, mỗi lần ~4–10k output.
LLM_MAX_OUTPUT_TOKENS=32000
# 'json' (mặc định) hoặc 'auto' (tool mode). Gemini compat cần 'json'.
LLM_OBJECT_MODE=json
# 'chunked' (mặc định, 4 lần gọi — hiện dần, lỗi cô lập) hoặc 'full' (1 lần, rẻ hơn
# nhưng Claude chặn vì schema 12 cung vượt giới hạn grammar).
LLM_CHUNK_MODE=chunked
# Field cần xoá khỏi request (Claude compat cấm temperature — tự bật khi baseURL là anthropic)
# LLM_STRIP_FIELDS=temperature
# Bỏ hẳn response_format khi provider không nhận schema lớn
# LLM_DROP_RESPONSE_FORMAT=true
# Thay schema chi tiết bằng schema rỗng (chỉ dùng khi bí, Zod vẫn validate sau)
# LLM_LOOSE_JSON_SCHEMA=true

# ---------------------------------------------------------------------------
# Tầng tri thức cổ học (tuvi.cohoc.net)
# ---------------------------------------------------------------------------
# false = tắt, chỉ luận từ JSON lá số
COHOC_ENABLED=true
